#!/bin/bash
# TUH: EDF -> windows -> pyspi, as a PBS array job.
#
#   bash docs/gadi/submit_tuh.sh <manifest.csv>       # wrapper handles batching
#
# Cost, extrapolated from the R1 measurement (M=20/T=1000 -> 3000 s/dataset at
# 48 concurrent workers, memory-bandwidth bound): M=22/T=1024 is ~1.2x the pairs,
# so ~3700 s/window. Yield is 5.5 windows/session (measured over 20 patients), so
# the 322-session manifest is ~1770 windows ~= 1820 CPU-hours ~= 3.6 kSU.
#
# EDFs must already be staged (docs/gadi/stage_data.sh, login node -- compute
# nodes have no internet).

#PBS -N tuh_gen
#PBS -P ql44
#PBS -q normal
#PBS -l ncpus=24
#PBS -l mem=96GB
#PBS -l walltime=05:00:00
#PBS -l storage=scratch/ql44+gdata/ql44
#PBS -l wd
#PBS -j oe
#PBS -r y

set -uo pipefail

MANIFEST="${MANIFEST:?set MANIFEST}"
EDF_ROOT="${EDF_ROOT:-/scratch/ql44/we2614/tusz/edf}"
OUT="${OUT:-/scratch/ql44/we2614/mts-spi-data/260728_tuh}"
# The generator repo lives in HOME, not on /scratch (only its data/ and logs/
# are symlinked out). Getting this wrong throws FileNotFoundError inside every
# worker, which reads as a data problem rather than a config-path problem.
GEN_REPO="${GEN_REPO:-$HOME/mts-spi-study-cluster}"
PYSPI_CONFIG="${PYSPI_CONFIG:-$GEN_REPO/configs/pyspi-v2/benchmarked90_amortized_config.yaml}"
CHUNK="${CHUNK:-24}"
SHARD="${PBS_ARRAY_INDEX:-${SHARD:-1}}"

module purge
module load python3/3.12.1
export UV_CACHE_DIR="${UV_CACHE_DIR:-/scratch/ql44/we2614/uv-cache}"
# Use the GENERATOR venv, not the eeml one: it is the only environment with a
# working pyspi. pyspi pins tslearn 0.6.3 -> numba 0.53.1, which refuses to
# build on Python >= 3.10, so `uv pip install -e ~/pyspi-fork` fails in a fresh
# 3.12 venv. The generator venv predates that pin resolution and works.
# It additionally needs mne for EDF reading:
#     source ~/mts-spi-study-cluster/.venv/bin/activate && uv pip install mne
VENV="${VENV:-$HOME/mts-spi-study-cluster/.venv}"
source "$VENV/bin/activate"
python -c "import pyspi, mne" || {
  echo "[FATAL] $VENV lacks pyspi or mne. Install mne there:"
  echo "  source $VENV/bin/activate && uv pip install mne"; exit 3; }
[ -f "$PYSPI_CONFIG" ] || {
  echo "[FATAL] pyspi config not found: $PYSPI_CONFIG"
  echo "  set GEN_REPO= or PYSPI_CONFIG= to the right location"; exit 4; }
[ -d "$EDF_ROOT" ] || { echo "[FATAL] EDF_ROOT missing: $EDF_ROOT"; exit 5; }
echo "[INFO] venv=$VENV"
echo "[INFO] pyspi_config=$PYSPI_CONFIG"
echo "[INFO] edf_root=$EDF_ROOT ($(find "$EDF_ROOT" -name '*.edf' | wc -l) EDFs)"
export OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1
export VECLIB_MAXIMUM_THREADS=1 NUMEXPR_NUM_THREADS=1 KMP_DUPLICATE_LIB_OK=TRUE
unset CUDA_VISIBLE_DEVICES || true
mkdir -p logs "$OUT"

echo "[INFO] shard $SHARD  chunk=$CHUNK  manifest=$MANIFEST  out=$OUT"

PYTHONPATH=. python -u - "$MANIFEST" "$EDF_ROOT" "$OUT" "$PYSPI_CONFIG" \
                        "$SHARD" "$CHUNK" <<'PY'
import csv, sys, os
from concurrent.futures import ProcessPoolExecutor, as_completed
from pathlib import Path
sys.path.insert(0, "docs")
import tuh_generator_reference as G

manifest, edf_root, out, cfg, shard, chunk = sys.argv[1:7]
shard, chunk = int(shard), int(chunk)
rows = [r for r in csv.reader(open(manifest)) if r and not r[0].startswith("#")]
mine = rows[(shard - 1) * chunk: shard * chunk]
print(f"[INFO] {len(mine)} sessions in this shard (of {len(rows)})", flush=True)
NW = int(os.environ.get("PBS_NCPUS", 24))


def resolve(root: Path, rel: str) -> Path:
    """Locate a staged file whose manifest path starts with 'edf/'.

    stage_data.sh joins DEST (which ends in /edf) with the manifest path (which
    also begins with edf/), so files land under <root>/edf/<split>/... Both
    layouts are accepted rather than assuming one, because getting this wrong
    fails SILENTLY: every session reports MISSING_EDF, the job exits 0, and
    nothing is written.
    """
    for cand in (root / rel, root / Path(rel).relative_to("edf")):
        if cand.exists():
            return cand
    return root / rel


def extract(row):
    edf = resolve(Path(edf_root), row[0])
    lab = resolve(Path(edf_root), row[1])
    if not edf.exists():
        return (edf.name, f"MISSING_EDF ({edf})", [])
    try:
        return (edf.name, "ok", G.session_windows(edf, lab, row[2], Path(out)))
    except Exception as e:
        return (edf.name, f"ERR {type(e).__name__}: {e}", [])


# PASS 1 -- extract windows. Cheap (EDF read + resample), finishes in minutes,
# and tells us exactly how much work pass 2 has.
todo, ok, err = [], 0, 0
with ProcessPoolExecutor(max_workers=NW) as ex:
    for f in as_completed([ex.submit(extract, r) for r in mine]):
        name, status, dirs = f.result()
        if status == "ok":
            ok += 1; todo += dirs
        else:
            err += 1; print(f"  {name}: {status}", flush=True)
print(f"[INFO] pass 1: sessions ok={ok} err={err} windows={len(todo)}", flush=True)


def spis(d):
    try:
        return (d.name, G.compute_window_spis(d, cfg))
    except Exception as e:
        return (d.name, f"ERR {type(e).__name__}: {e}")


# PASS 2 -- one task per WINDOW, not per session. A session's windows used to be
# computed serially inside one worker, so a shard's wall time was set by its
# longest session however sessions were chunked across nodes. Skips any window
# whose meta.json exists, so a re-run after a walltime kill resumes.
done = skipped = failed = 0
with ProcessPoolExecutor(max_workers=NW) as ex:
    for i, f in enumerate(as_completed([ex.submit(spis, d) for d in todo]), 1):
        name, status = f.result()
        if status == "ok":
            done += 1
        elif status == "skip":
            skipped += 1
        else:
            failed += 1; print(f"  {name}: {status}", flush=True)
        if i % 25 == 0:
            print(f"  [progress] {i}/{len(todo)} windows", flush=True)

written = done + skipped
print(f"[INFO] sessions ok={ok} err={err}  windows written={written} "
      f"(new={done} resumed={skipped} failed={failed})")
if written == 0:
    # Exit non-zero so a chained `qsub -W depend=afterok` does NOT start
    # training on an empty dataset. The first run of this job exited 0 after
    # three seconds having written nothing, and the chained training ran anyway.
    print("[FATAL] no windows written -- failing so dependent jobs do not run")
    sys.exit(2)
PY

echo "[INFO] shard $SHARD done $(date)"
