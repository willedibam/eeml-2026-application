#!/bin/bash
# Stability selection + a lambda PATH for the recovered signature.
#
#   qsub -v DATA=<dir>,CLASSES="a b c",TAG=r0297 docs/gadi/stability.pbs
#
# Why both, and why this matters more than another accuracy number.
#
# The recovered signature is a lasso SELECTION, and a lasso path is a family of
# solutions indexed by lambda -- which variables are chosen is a function of
# lambda by construction. Reporting one point on that path as "the signature"
# is the error. It is worse here than in a typical model because selection
# consistency requires the irrepresentable condition (Zhao & Yu 2006), and this
# vocabulary violates it badly: the causal family has 48 members spanning ~4.3
# effective dimensions, so near-duplicates compete and the argmax is unstable.
#
# Measured on VAR at K=125: across a 10x lambda range the top FAMILY flips
# (distance <-> causal) while directed ENRICHMENT stays 1.75-2.20x. The
# set-level statistic is robust where the argmax is not.
#
# So this job produces the two things the literature asks for:
#   1. the lambda path of enrichment (is the readout stable, or a point pick?)
#   2. stability selection (Meinshausen & Buhlmann 2010) -- selection
#      FREQUENCY under subsampling, which is the honest unit for a claim about
#      which statistics the model uses.

#PBS -N eeml_stability
#PBS -P ql44
#PBS -q normal
#PBS -l ncpus=12
#PBS -l mem=96GB
#PBS -l walltime=06:00:00
#PBS -l storage=scratch/ql44+gdata/ql44
#PBS -l wd
#PBS -j oe

set -uo pipefail

DATA="${DATA:?set DATA}"
CLASSES="${CLASSES:?set CLASSES}"
TAG="${TAG:-stability}"
NTRAIN="${NTRAIN:-700}"
SUBS="${SUBS:-50}"

module purge
module load python3/3.12.1
export UV_CACHE_DIR="${UV_CACHE_DIR:-/scratch/ql44/we2614/uv-cache}"
source .venv/bin/activate
export OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1
export VECLIB_MAXIMUM_THREADS=1 NUMEXPR_NUM_THREADS=1 KMP_DUPLICATE_LIB_OK=TRUE
unset CUDA_VISIBLE_DEVICES || true
mkdir -p logs results

# --- 1. lambda path: is the readout a stable property or a point pick? ---
echo "### lambda path" >&2
for gl in 0.001 0.002 0.005 0.01 0.02 0.05; do
  ( python -u -m src.run_pipeline --data-dir "$DATA" --class-names $CLASSES \
      --mode sample-efficiency --n-train "$NTRAIN" \
      --test-per-class 200 --val-per-class 100 --seeds 5 \
      --models spi-mpnn --group-lambda "$gl" --spi-groups literature \
      --device cpu --tag "${TAG}_path_gl${gl}" > "logs/${TAG}_path_gl${gl}.log" 2>&1 ) &
done
wait

# --- 2. stability selection at the middle of the path ---
echo "### stability selection ($SUBS subsamples)" >&2
PYTHONPATH=. python -u docs/run_stability_selection.py \
  --data-dir "$DATA" --class-names $CLASSES \
  --n-train "$NTRAIN" --n-val 100 --n-subsamples "$SUBS" \
  --max-epochs 200 --group-lambda 0.01 --min-val-f1 0.75 \
  --tag "${TAG}" > "logs/${TAG}_stability.log" 2>&1

echo
echo "==================== LAMBDA PATH ===================="
for gl in 0.001 0.002 0.005 0.01 0.02 0.05; do
  f="results/sample_efficiency_${TAG}_path_gl${gl}_results.json"
  [[ -f "$f" ]] || { echo "-- gl=$gl MISSING"; continue; }
  echo "-------- lambda=$gl --------"
  PYTHONPATH=. python docs/enrichment_2x2.py "$f" 2>/dev/null | grep -E "F1=|directed |modules|M[0-9]{2} " | head -8
done

echo
echo "==================== STABILITY SELECTION ===================="
tail -30 "logs/${TAG}_stability.log"
echo "==================== END ===================="
