#!/bin/bash
# TUH experiment battery, sharded by (MODEL, SEED).
#
#   qsub -v DATA=<dir> docs/gadi/tuh_train.pbs
#   qsub -v DATA=<dir>,SEEDS=2,NTRAIN=20 docs/gadi/tuh_train.pbs     # smoke test
#
# CONTROLS decide whether anything else is interpretable, so they are reported
# first (docs/tuh_report.py):
#   node-only  per-channel statistics only. If this clears chance the classes
#              differ in what individual channels DO rather than how they
#              couple, the SPI vocabulary is mismatched, and the coupling claim
#              is void -- exactly how motor-imagery and SelfRegulationSCP1
#              failed (CLAUDE.md scope).
#   shuffled   SPI values permuted across pairs. Tests that pair correspondence,
#              not the marginal distribution of values, carries the signal.
#
# Every run uses --group-by-patient: TUH cuts several windows per recording, so
# an instance-level split would put the same subject on both sides.
#
# PARALLELISM. Fits are independent along (model, seed); n_train is NOT, because
# the SPI filter is computed from the largest n in the process, and because
# merge_shards would silently drop n-blocks rather than error. So the unit is
# (model, seed) = 7 x SEEDS processes, each running only its own model over the
# n grid. Previously four config groups ran on 12 cores and the longest ground
# through 24 training runs serially.
#
# src.analysis --merge recombines SEEDS for one model. It must NOT be used to
# combine different models: _merge_models iterates the first shard's model dict
# and silently drops models it lacks. Models are combined at report time.

#PBS -N tuh_train
#PBS -P ql44
#PBS -q normal
#PBS -l ncpus=48
#PBS -l mem=190GB
#PBS -l walltime=06:00:00
#PBS -l storage=scratch/ql44+gdata/ql44
#PBS -l wd
#PBS -j oe

set -uo pipefail

DATA="${DATA:-/scratch/ql44/we2614/mts-spi-data/260728_tuh}"
SEEDS="${SEEDS:-5}"
NTRAIN="${NTRAIN:-20 50 100 200 400}"
JOBS="${JOBS:-35}"

module purge
module load python3/3.12.1
export UV_CACHE_DIR="${UV_CACHE_DIR:-/scratch/ql44/we2614/uv-cache}"
source .venv/bin/activate
export OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1
export VECLIB_MAXIMUM_THREADS=1 NUMEXPR_NUM_THREADS=1 KMP_DUPLICATE_LIB_OK=TRUE
unset CUDA_VISIBLE_DEVICES || true
mkdir -p logs results

echo "[INFO] TUH battery $(date)  data=$DATA  seeds=$SEEDS  n=$NTRAIN  jobs=$JOBS"

MANIFEST="${MANIFEST:-docs/tuh/manifest.csv}"
WANT=$(grep -vc '^#' "$MANIFEST" 2>/dev/null || echo 0)
GOT=$(grep -h "sessions ok=" tuh_gen.o* 2>/dev/null \
      | sed -E 's/.*ok=([0-9]+) err=([0-9]+).*/\1 \2/' \
      | awk '{t += $1 + $2} END {print t+0}')
if [ "${ALLOW_PARTIAL:-0}" = "1" ]; then
  echo "[WARN] ALLOW_PARTIAL=1 -- training on a PARTIAL corpus by request."
elif [ "$WANT" -gt 0 ] && [ "$GOT" -lt "$WANT" ]; then
  echo "[FATAL] generation incomplete ($GOT/$WANT sessions). Shards still"
  echo "        running would be written to WHILE this job reads them."
  exit 6
fi

for c in fnsz gnsz; do
  n=$(find "$DATA/$c" -name spi_mpis.npz 2>/dev/null | wc -l)
  echo "  $c: $n instances, $(ls "$DATA/$c" 2>/dev/null | cut -d_ -f1 | sort -u | wc -l) patients"
  [ "$n" -lt 100 ] && { echo "[FATAL] too few $c instances"; exit 2; }
done

# Stale shards from an earlier run would be picked up by --merge and reported as
# if they belonged to this one.
rm -f results/*tuh_*_s[0-9]*_results.json results/tuh_*_merged_results.json

CMDS=$(mktemp)
emit () {   # key, models, lambda
  for ((s = 0; s < SEEDS; s++)); do
    printf '%s\n' "python -u -m src.run_pipeline --data-dir '$DATA' \
--class-names fnsz gnsz --group-by-patient --mode sample-efficiency \
--n-train $NTRAIN --test-per-class 150 --val-per-class 100 \
--seeds 1 --seed-offset $s --models $2 --group-lambda $3 \
--spi-groups literature --device cpu --tag tuh_${1}_s${s} \
> logs/tuh_${1}_s${s}.log 2>&1 || echo '### FAIL ${1}_s${s}'" >> "$CMDS"
  done
}
emit node_only       "node-only"       0.01
emit shuffled        "shuffled"        0.01
emit spi_mpnn        "spi-mpnn"        0.01
emit latent_directed "latent-directed" 0.01
emit fixed_spi       "fixed-spi"       0.01
emit gl002           "spi-mpnn"        0.002
emit gl005           "spi-mpnn"        0.005

echo "[INFO] $(wc -l < "$CMDS") shards, pool of $JOBS"
xargs -P "$JOBS" -I CMD bash -c CMD < "$CMDS"
rm -f "$CMDS"

for k in node_only shuffled spi_mpnn latent_directed fixed_spi gl002 gl005; do
  python -m src.analysis --merge "tuh_${k}" results >/dev/null 2>&1 \
    || echo "### merge FAILED tuh_${k}"
done

REPORT="logs/tuh_report.txt"
{
python docs/tuh_report.py results
echo
PYTHONPATH=. python docs/enrichment_2x2.py results/tuh_spi_mpnn_merged_results.json 2>/dev/null || true
} | tee "$REPORT"

echo "[INFO] done $(date). report: $REPORT"
