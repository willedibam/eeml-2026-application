#!/bin/bash
# TUH experiment battery, sharded by seed.
#
#   qsub docs/gadi/tuh_train.pbs
#
# Order matters here. On real EEG the CONTROLS decide whether anything else is
# interpretable, so they run first and are reported first:
#
#   node-only   per-channel statistics only. If this clears chance, the classes
#               differ in what individual channels DO rather than how they
#               couple, the SPI vocabulary is mismatched, and the coupling claim
#               is void. This is exactly how motor-imagery and SelfRegulationSCP1
#               failed (CLAUDE.md scope).
#   shuffled    SPI values permuted across pairs. Tests that pair correspondence,
#               not the marginal distribution of SPI values, carries the signal.
#
# Every run uses --group-by-patient. TUH cuts several windows per recording, so
# an instance-level random split would place the same subject on both sides and
# the score would measure memorisation.
#
# WHY SHARDED. The previous version ran four configs in parallel on 12 cores and
# used four of them; wall time was set by the longest config running its 60 fits
# sequentially (~5 h, against a 6 h wall). Fits are independent, so the unit of
# parallelism is (config, seed): 4 configs x 5 seeds = 20 processes, longest is
# 12 fits (~1 h). src/analysis.py --merge then recombines the per-seed shards,
# which is the same path docs/gadi/baselines.pbs already uses.

#PBS -N tuh_train
#PBS -P ql44
#PBS -q normal
#PBS -l ncpus=24
#PBS -l mem=96GB
#PBS -l walltime=06:00:00
#PBS -l storage=scratch/ql44+gdata/ql44
#PBS -l wd
#PBS -j oe

set -uo pipefail

DATA="${DATA:-/scratch/ql44/we2614/mts-spi-data/260728_tuh}"
SEEDS="${SEEDS:-5}"
NTRAIN="${NTRAIN:-20 50 100 200}"
JOBS="${JOBS:-20}"

module purge
module load python3/3.12.1
export UV_CACHE_DIR="${UV_CACHE_DIR:-/scratch/ql44/we2614/uv-cache}"
source .venv/bin/activate
export OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1
export VECLIB_MAXIMUM_THREADS=1 NUMEXPR_NUM_THREADS=1 KMP_DUPLICATE_LIB_OK=TRUE
unset CUDA_VISIBLE_DEVICES || true
mkdir -p logs results

echo "[INFO] TUH battery start $(date)  data=$DATA  seeds=$SEEDS  jobs=$JOBS"

# REFUSE to run while generation is still going. An instance count alone is not
# enough: it passes on a partial corpus, and a worker may be mid-write on the
# very .npz this job is about to read. Each finished shard prints one
# "sessions ok=N err=M" line to its .o file, so the sessions accounted for must
# equal the manifest before training is allowed to start.
MANIFEST="${MANIFEST:-docs/tuh/manifest.csv}"
WANT=$(grep -vc '^#' "$MANIFEST" 2>/dev/null || echo 0)
GOT=$(grep -h "sessions ok=" tuh_gen.o* 2>/dev/null \
      | sed -E 's/.*ok=([0-9]+) err=([0-9]+).*/\1 \2/' \
      | awk '{t += $1 + $2} END {print t+0}')
echo "[INFO] generation accounted for $GOT of $WANT manifest sessions"
if [ "${ALLOW_PARTIAL:-0}" = "1" ]; then
  echo "[WARN] ALLOW_PARTIAL=1 -- training on a PARTIAL corpus by request."
  echo "       Controls (node-only, shuffled) are still valid on a subset;"
  echo "       accuracy and signature will change when the rest arrives."
elif [ "$WANT" -gt 0 ] && [ "$GOT" -lt "$WANT" ]; then
  echo "[FATAL] generation incomplete ($GOT/$WANT sessions)."
  echo "        Shards still running would be written to WHILE this job reads"
  echo "        them. Wait for 'tuh_gen shards: 0 still running', then resubmit."
  exit 6
fi

for c in fnsz gnsz; do
  n=$(find "$DATA/$c" -name spi_mpis.npz 2>/dev/null | wc -l)
  echo "  $c: $n instances"
  [ "$n" -lt 100 ] && { echo "[FATAL] too few $c instances -- refusing to train"; exit 2; }
done

# One line per (config, seed). Written to a file and fed to xargs so the whole
# battery is one bounded pool rather than four serial queues.
CMDS=$(mktemp)
emit () {   # tag, models, lambda
  for ((s = 0; s < SEEDS; s++)); do
    printf '%s\n' "python -u -m src.run_pipeline --data-dir '$DATA' \
--class-names fnsz gnsz --group-by-patient --mode sample-efficiency \
--n-train $NTRAIN --test-per-class 150 --val-per-class 100 \
--seeds 1 --seed-offset $s --models $2 --group-lambda $3 \
--spi-groups literature --device cpu --tag ${1}_s${s} \
> logs/${1}_s${s}.log 2>&1 || echo '### FAIL ${1}_s${s}'" >> "$CMDS"
  done
}
emit tuh_controls "node-only shuffled" 0.01
emit tuh_main     "spi-mpnn latent-directed fixed-spi" 0.01
emit tuh_gl002    "spi-mpnn" 0.002
emit tuh_gl005    "spi-mpnn" 0.005

echo "[INFO] $(wc -l < "$CMDS") shard jobs, pool of $JOBS"
xargs -P "$JOBS" -I CMD bash -c CMD < "$CMDS"
rm -f "$CMDS"

for t in tuh_controls tuh_main tuh_gl002 tuh_gl005; do
  python -m src.analysis --merge "$t" results || echo "### merge FAILED $t"
done

REPORT="logs/tuh_report.txt"
{
echo "==================== TUH REPORT ===================="
for t in tuh_controls tuh_main tuh_gl002 tuh_gl005; do
  f="results/${t}_merged_results.json"
  [[ -f "$f" ]] || { echo "-- $t MISSING (see logs/${t}_s*.log)"; continue; }
  echo; echo "-------- $t --------"
  grep -m1 "patient-split" "logs/${t}_s0.log" || echo "  [no patient-split line -- CHECK]"
  python - "$f" <<'PY'
import json,sys
r=json.load(open(sys.argv[1]))
ms=sorted(r['results'][max(r['results'],key=int)]['models'])
print("  n    " + "".join(f"{m:>20}" for m in ms))
for n in sorted(r['results'],key=int):
    d=r['results'][n]['models']
    print(f"  {n:<5}" + "".join(f"{d[m]['f1_mean']:>13.4f}+/-{d[m]['f1_std']:.2f}" for m in ms))
PY
  PYTHONPATH=. python docs/enrichment_2x2.py "$f" 2>/dev/null \
    | grep -E "F1=|directed |nonlinear|M[0-9]{2} |MXX " || true
done
echo
echo "READ THE CONTROLS FIRST."
echo "  node-only near 0.50 (chance) => classes differ in COUPLING, claim is live."
echo "  node-only high              => classes differ in per-channel activity;"
echo "                                 SPI vocabulary mismatched, claim is void."
echo "  shuffled near 0.50          => pair correspondence carries the signal."
echo "==================== END ===================="
} | tee "$REPORT"

echo "[INFO] done $(date). report: $REPORT"
