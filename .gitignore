# Data (exported from mts-spi-study-cluster, not tracked)
data/*
!data/.gitkeep
data/

# Python
__pycache__/
*.pyc
*.egg-info/
dist/
build/
.eggs/
.venv/
.venv*
*venv

# IDE
.vscode/
.idea/

# OS
.DS_Store

# Office temp lock files
~$*

# Result JSONs and logs are GENERATED ARTIFACTS produced on the cluster. They
# were committed by accident (a `git add -A` after rsyncing them down for local
# analysis) which bloated the repo and blocked `git pull` on Gadi, where the
# same files exist untracked. Analysis scripts read them from wherever they sit;
# nothing needs them in version control.
results/
logs/
